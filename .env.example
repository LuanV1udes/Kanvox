# Copie este arquivo para ".env" e preencha com os valores reais.
# O .env real NUNCA é commitado (está no .gitignore) — cada dev/máquina tem o seu.

# Banco de dados PostgreSQL (opcional — os padrões abaixo já batem com o setup do README)
BANCO_URL=jdbc:postgresql://localhost:5432/kanvox
BANCO_USUARIO=kanvox
BANCO_SENHA=kanvox

# Chave usada para assinar os tokens JWT (obrigatório trocar em produção)
CHAVE_JWT=

# Transcrição de áudio via Whisper na API da Groq (RF-05) — gere uma chave gratuita em console.groq.com
GROQ_API_KEY=

# Envio de e-mail para recuperação de senha (RF-01.3) — opcional, sem isso só não envia o e-mail de verdade
# No Gmail, gere uma "senha de app" em myaccount.google.com/apppasswords (não use a senha normal da conta)
SMTP_USUARIO=
SMTP_SENHA=
